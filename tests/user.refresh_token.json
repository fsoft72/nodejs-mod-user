{
    "system": {
        "base_url": "http://localhost:12000",
        "authorization_template": "Bearer %(token)s"
    },
    "actions": [
        {
            "method": "post",
            "url": "/api/user/register",
            "auth": false,
            "title": "Registering a new user",
            "params": {
                "email": "mario.rossi.test@gmail.com",
                "password": "Ciao123!",
                "name": "Mario",
                "lastname": "Rossi TEST",
                "recaptcha": "test"
            },
            "tests": [
                {
                    "field": "data",
                    "mode": "SIZE-GT",
                    "value": 0
                }
            ],
            "fields": [
                [
                    "data",
                    "code"
                ]
            ]
        },
        {
            "method": "get",
            "url": "/api/user/register/activate/%(code)s",
            "auth": false,
            "tests": [
                {
                    "field": "data.name",
                    "mode": "EQUAL",
                    "value": "Mario"
                }
            ]
        },
        {
            "method": "post",
            "url": "/api/user/token",
            "content": "form",
            "auth": false,
            "params": {
                "username": "mario.rossi.test@gmail.com",
                "password": "Ciao123!"
            },
            "tests": [
                {
                    "field": "data.access_token",
                    "mode": "SIZE-GT",
                    "value": 0
                },
                {
                    "field": "data.token_type",
                    "mode": "EQUAL",
                    "value": "bearer"
                }
            ],
            "fields": [
                [
                    "data.access_token",
                    "token"
                ]
            ]
        },
        {
            "method": "get",
            "url": "/api/user/logout",
            "auth": true
        },
        {
            "method": "post",
            "url": "/api/user/login",
            "auth": false,
            "params": {
                "email": "mario.rossi.test@gmail.com",
                "password": "Ciao123!",
                "recaptcha": "test"
            },
            "fields": [
                [
                    "data.access_token",
                    "token"
                ],
                [
                    "data.refresh_token",
                    "refresh_token"
                ],
                [
                    "data.id",
                    "mario_id_user"
                ]
            ]
        },
        {
            "method": "post",
            "url": "/api/user/login/refresh",
            "auth": false,
            "params": {
                "token": "%(refresh_token)s"
            },
            "fields": [
                [
                    "data.access_token",
                    "token"
                ],
                [
                    "data.refresh_token",
                    "refresh_token"
                ]
            ]
        },
        {
            "method": "get",
            "url": "/api/user/me",
            "auth": true,
            "tests": [
                {
                    "field": "data.name",
                    "mode": "EQUAL",
                    "value": "Mario"
                }
            ]
        },
        {
            "method": "post",
            "url": "/api/user/login/refresh",
            "auth": false,
            "params": {
                "token": "%(refresh_token)s"
            },
            "tests": [
                {
                    "field": "data.access_token",
                    "mode": "SIZE-GT",
                    "value": 0
                },
                {
                    "field": "data.refresh_token",
                    "mode": "NOT_EQUAL",
                    "value": "%(refresh_token)s"
                }
            ]
        },
        {
            "method": "post",
            "url": "/api/user/login",
            "params": {
                "email": "admin@gmail.com",
                "password": "UserAdmin1!",
                "recaptcha": "ciao"
            },
            "fields": [
                [
                    "data.access_token",
                    "token"
                ]
            ]
        },
        {
            "method": "delete",
            "url": "/api/user/admin/del",
            "params": {
                "id_user": "%(mario_id_user)s"
            }
        }
    ]
}